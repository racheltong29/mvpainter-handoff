+import os
+import sys
+import time
+import trimesh
+from glob import glob
+from scripts.remesh_reduce_blender_script import remesh_and_replace, reduce_mesh
+import argparse
+
+_THIS_DIR = os.path.dirname(os.path.abspath(__file__))
+_PYTHON = sys.executable
+_BLENDER = os.path.join(_THIS_DIR, '..', 'blender-4.2.9-linux-x64', 'blender')
+
+parser = argparse.ArgumentParser()
+parser.add_argument('--mv_res_dir', type=str, default='./outputs/test/mvpainter')
+parser.add_argument('--output_dir', type=str, default='./results/test/mvpainter')
+parser.add_argument('--geo_rotation', type=int, default=-90)
+parser.add_argument('--use_pbr', action='store_true')
+args = parser.parse_args()
+
+input_dir = args.mv_res_dir
+save_path = args.output_dir
+use_pbr = args.use_pbr
+
+
+def timed_run(label, cmd):
+    print(f"\n[TIMED] START {label}")
+    t0 = time.time()
+    rc = os.system(cmd)
+    elapsed = time.time() - t0
+    status = "OK" if rc == 0 else f"FAILED (exit {rc})"
+    print(f"[TIMED] END   {label}  {elapsed:.1f}s  {status}")
+    if rc != 0:
+        raise RuntimeError(f"Command failed (exit {rc}):\n{cmd}")
+    return elapsed
+
+
+# Log mesh complexity before baking
+objs = glob(os.path.join(input_dir, '*', 'blender.obj'))
+print(os.path.join(input_dir, '*', 'blender.obj'))
+for obj in objs:
+    try:
+        m = trimesh.load(obj, force='mesh', process=False)
+        if hasattr(m, 'faces'):
+            faces, verts = len(m.faces), len(m.vertices)
+        else:
+            faces = sum(len(s.faces) for s in m.geometry.values())
+            verts = sum(len(s.vertices) for s in m.geometry.values())
+        print(f"[TIMED] mesh {os.path.basename(os.path.dirname(obj))}: {faces:,} faces, {verts:,} verts (blender.obj)")
+    except Exception as e:
+        print(f"[TIMED] mesh load error for {obj}: {e}")
+
+    if os.path.exists(obj.replace('.obj', '_low.obj')):
+        try:
+            m2 = trimesh.load(obj.replace('.obj', '_low.obj'), force='mesh', process=False)
+            if hasattr(m2, 'faces'):
+                lf, lv = len(m2.faces), len(m2.vertices)
+            else:
+                lf = sum(len(s.faces) for s in m2.geometry.values())
+                lv = sum(len(s.vertices) for s in m2.geometry.values())
+            print(f"[TIMED] mesh {os.path.basename(os.path.dirname(obj))}: {lf:,} faces, {lv:,} verts (blender_low.obj)")
+        except Exception as e:
+            print(f"[TIMED] low mesh load error: {e}")
+    else:
+        t0 = time.time()
+        reduce_mesh(obj, target_vertices=30000, output_path=obj.replace('.obj', '_low.obj'))
+        print(f"[TIMED] reduce_mesh: {time.time()-t0:.1f}s")
+
+offset = args.geo_rotation + 90
+stage_times = {}
+
+if not use_pbr:
+    stage_times['bake_pipeline'] = timed_run(
+        'bake_pipeline',
+        f'cd {_THIS_DIR}/mvpainter/ && '
+        f'{_PYTHON} bake_pipeline_timed.py --input_dir {input_dir} '
+        f'--save_dir {os.path.join(save_path, "glbs")} --offset {offset}'
+    )
+else:
+    stage_times['bake_pipeline_basecolor'] = timed_run(
+        'bake_pipeline basecolor',
+        f'cd {_THIS_DIR}/mvpainter/ && '
+        f'{_PYTHON} bake_pipeline_timed.py --input_dir {input_dir} '
+        f'--save_dir {os.path.join(save_path, "basecolor")} --offset {offset} --suffix _basecolor'
+    )
+
+    stage_times['blender_bake_basecolor'] = timed_run(
+        'blender_bake basecolor',
+        f'cd {_THIS_DIR}/scripts && '
+        f'{_BLENDER} --background --python blender_bake.py -- '
+        f'--input_dir {os.path.join(save_path, "basecolor")} '
+        f'--save_dir {os.path.join(save_path, "basecolor_bake")}'
+    )
+
+    stage_times['bake_pipeline_metallic'] = timed_run(
+        'bake_pipeline metallic',
+        f'cd {_THIS_DIR}/mvpainter/ && '
+        f'{_PYTHON} bake_pipeline_timed.py --input_dir {input_dir} '
+        f'--save_dir {os.path.join(save_path, "metallic")} --offset {offset} --suffix _metallic'
+    )
+
+    stage_times['blender_bake_metallic'] = timed_run(
+        'blender_bake metallic',
+        f'cd {_THIS_DIR}/scripts && '
+        f'{_BLENDER} --background --python blender_bake.py -- '
+        f'--input_dir {os.path.join(save_path, "metallic")} '
+        f'--save_dir {os.path.join(save_path, "metallic_bake")}'
+    )
+
+    stage_times['bake_pipeline_roughness'] = timed_run(
+        'bake_pipeline roughness',
+        f'cd {_THIS_DIR}/mvpainter/ && '
+        f'{_PYTHON} bake_pipeline_timed.py --input_dir {input_dir} '
+        f'--save_dir {os.path.join(save_path, "roughness")} --offset {offset} --suffix _roughness'
+    )
+
+    stage_times['blender_bake_roughness'] = timed_run(
+        'blender_bake roughness',
+        f'cd {_THIS_DIR}/scripts && '
+        f'{_BLENDER} --background --python blender_bake.py -- '
+        f'--input_dir {os.path.join(save_path, "roughness")} '
+        f'--save_dir {os.path.join(save_path, "roughness_bake")}'
+    )
+
+    stage_times['blender_pbr_glb'] = timed_run(
+        'blender_pbr_glb',
+        f'cd {_THIS_DIR} && {_BLENDER} --background -Y --python scripts/blender_pbr_glb.py -- '
+        f'--basecolor_dir {os.path.join(save_path, "basecolor_bake")} '
+        f'--metallic_dir {os.path.join(save_path, "metallic_bake")} '
+        f'--roughness_dir {os.path.join(save_path, "roughness_bake")} '
+        f'--output_dir {os.path.join(save_path, "combine_pbr")}'
+    )
+
+total = sum(stage_times.values())
+print("\n[TIMED] Stage 3 summary:")
+for label, secs in stage_times.items():
+    print(f"  {label:<35} {secs:6.1f}s  ({100*secs/total:.0f}%)")
+print(f"  {'TOTAL':<35} {total:6.1f}s")
